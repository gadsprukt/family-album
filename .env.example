# Copy this file to .env.local and fill in your own keys.

# OpenAI key — used for Whisper transcription of the Hebrew voice notes.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Runway key — used to animate the photos (gentle 2-3 movement clips).
# Get one at https://app.runwayml.com/ (Settings -> API Keys)
RUNWAY_API_KEY=

# A private "password" used to view the album page.
# Anyone with the album link AND this code can view it.
ALBUM_ACCESS_CODE=change-me

# A separate code used only for the upload/add-memory page.
# Keep this one just between you and your grandmother.
UPLOAD_ACCESS_CODE=change-me-too
